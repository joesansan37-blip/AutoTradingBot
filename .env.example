# Runtime mode: the only supported value is paper.
EXECUTION_MODE=paper

# Public market data; no exchange API keys are used.
DATA_EXCHANGE=kraken
TRADING_SYMBOL=SOL/USDT
TIMEFRAME=15m

# Paper ledger and simulation risk parameters.
PAPER_STARTING_BALANCE_USDT=500
PAPER_STATE_FILE=paper_account.json
ORDER_MARGIN_USDT=25
LEVERAGE=2
STOP_LOSS_PCT=2
TAKE_PROFIT_PCT=4
PAPER_FEE_RATE=0.0006
MAX_DAILY_LOSS_USDT=25
SCAN_SECONDS=15

# Optional Telegram control panel. Set both values or leave both blank.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Logging: plain is human-readable; json is structured for hosted log platforms.
LOG_LEVEL=INFO
LOG_FORMAT=plain

# Strategy parameters.
STRATEGY_EMA_FAST=20
STRATEGY_EMA_SLOW=50
STRATEGY_RSI_PERIOD=14
STRATEGY_RSI_LONG=55
STRATEGY_RSI_SHORT=45
STRATEGY_ATR_PERIOD=14
STRATEGY_MIN_VOLATILITY_PCT=0.003
STRATEGY_MAX_VOLATILITY_PCT=0.05
STRATEGY_TREND_SLOPE_PERIOD=5
STRATEGY_TREND_SLOPE_FILTER=true
STRATEGY_MAX_RISK_PCT=0.05
STRATEGY_MIN_MARGIN=5
